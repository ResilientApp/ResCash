# ============================================
# ResCash Backend Configuration Example
# ============================================
# Copy this file to backend/.env and configure for your environment

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=rescash_test

# ResilientDB Configuration
# Replace YOUR_RESILIENTDB_HOST with your actual ResilientDB server address
GRAPHQL_URI=http://YOUR_RESILIENTDB_HOST:8000/graphql
CROW_SERVER_URI=http://YOUR_RESILIENTDB_HOST:18000/v1/transactions

# Security Configuration
# Generate random secrets for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_here
JWT_SECRET=your_random_jwt_secret_here

# Server Configuration
PORT=8099
HOST=127.0.0.1

# Feature Flags
ENABLE_RESILIENT_SYNC=false    # Set to true when ResilientDB is available
ENABLE_DEV_LOGIN=true          # Set to false in production
DEV_PUBLIC_KEY=LOCAL_TEST_PUBLIC_KEY
