# ============================================
# ResCash Frontend Configuration Example
# ============================================
# Copy this file to resCash/.env.local and configure for your environment

# Development Mode
# Set to false in production to enforce ResVault authentication
REACT_APP_ENABLE_DEV_LOGIN=true

# Backend API URL
# For local development: http://localhost:8099
# For production: https://your-domain.com/api or http://your-server-ip:8099
REACT_APP_API_BASE_URL=http://localhost:8099
