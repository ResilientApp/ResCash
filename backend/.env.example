# ============================================
# ResCash Backend Environment Configuration
# ============================================

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=rescash_production

# ResilientDB Configuration
# Replace with your ResilientDB GraphQL and Crow server endpoints
GRAPHQL_URI=http://YOUR_RESILIENTDB_HOST:8000/graphql
CROW_SERVER_URI=http://YOUR_RESILIENTDB_HOST:18000/v1/transactions

# Security Configuration
# IMPORTANT: Generate strong secrets for production!
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_IN_PRODUCTION
JWT_SECRET=CHANGE_THIS_TO_RANDOM_JWT_SECRET_IN_PRODUCTION

# Server Configuration
PORT=8099
HOST=0.0.0.0

# Feature Flags
# Set ENABLE_RESILIENT_SYNC to true to enable blockchain synchronization
ENABLE_RESILIENT_SYNC=true

# Development Mode
# WARNING: Set ENABLE_DEV_LOGIN to false in production!
# This bypasses ResVault authentication for local testing only
ENABLE_DEV_LOGIN=false
DEV_PUBLIC_KEY=
