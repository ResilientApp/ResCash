# ============================================
# ResCash Frontend Environment Configuration
# ============================================

# Development Mode
# WARNING: Set to false in production to enforce ResVault authentication
REACT_APP_ENABLE_DEV_LOGIN=false

# Backend API URL
# For local development: http://localhost:8099
# For production: Replace with your actual backend server URL
REACT_APP_API_BASE_URL=http://localhost:8099
